pkgname = linux-enigmarsos
	pkgdesc = The EnigmarsOS Linux kernel and modules (BORE scheduler)
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-enigmarsos-headers: headers and scripts for building modules
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux: official Arch kernel used as the EnigmarsOS fallback
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE

pkgname = linux-enigmarsos-headers
	pkgdesc = Headers and scripts for building modules for the EnigmarsOS Linux kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
